# Copy to backend/.env and fill in. Never commit real values.

# --- General ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./mailsense.db
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SECRET_KEY=
ENCRYPTION_KEY=
ADMIN_EMAILS=
# Empty = any account may sign in. For UM only: siswa.um.edu.my,siswa365.um.edu.my
ALLOWED_EMAIL_DOMAINS=

# --- Microsoft sign-in (Siswamail / Outlook) ---
# Microsoft Entra app registration. Redirect URI: {BACKEND_URL}/api/v1/auth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# --- Google sign-in (Gmail) ---
# Google Cloud OAuth client. Redirect URI: {BACKEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI: Llama 4 Scout through an online API ---
# LLM_PROVIDER: groq (console.groq.com) | openrouter (openrouter.ai) | together (together.ai)
LLM_PROVIDER=groq
LLM_API_KEY=
# Leave empty to use the provider's Llama 4 Scout model
LLM_MODEL=
LLM_BASE_URL=
# Safety cap on tokens per day (0 = no limit)
LLM_DAILY_TOKEN_LIMIT=2000000
AI_MAX_ATTEMPTS=3

# --- Mail sync ---
SYNC_INTERVAL_MINUTES=10
SYNC_MAX_MESSAGES=50
SYNC_ENABLED=true
